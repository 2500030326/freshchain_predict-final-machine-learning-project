  "viva_questions": [
    {
      "q": "Why doesn't agglomerative clustering require K to be specified in advance?",
      "a": "Because it builds a complete dendrogram from N singleton leaves to 1 root, encoding every possible partition from K=N to K=1 simultaneously."
    },
    {
      "q": "Can a dendrogram ever have a merge height LOWER than one of its children's height?",
      "a": "For metric linkages (Single, Complete, Average, Ward), merge heights are strictly monotonic (h_parent >= h_child). Centroid or median linkage can cause non-monotonic inversions."
    },
    {
      "q": "Why is Ward's linkage often called 'K-Means in disguise'?",
      "a": "Because both optimize the exact same objective: minimizing Within-Cluster Sum of Squares (WCSS / variance increase)."
    }
  ]
